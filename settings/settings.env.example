# Copy to settings/settings.env for local runs. Do not commit credentials.

# AWS profile to use. If unset, AWS CLI default resolution is used.
# AWS_PROFILE=default

# Discovery region mode:
# - current: only AWS_REGION/AWS_DEFAULT_REGION, or us-east-1 fallback
# - all: all enabled EC2 regions visible to the caller
DISCOVERY_REGION_MODE=current

# Optional explicit comma-separated region list. Overrides DISCOVERY_REGION_MODE.
# DISCOVERY_REGIONS=us-east-1,us-west-2

# Output root directories.
INVENTORY_DIR=inventory
WORK_DIR=artifacts

# Include ECS/EKS detection. These are read-only but can add API calls.
DETECT_CONTAINERS=true
